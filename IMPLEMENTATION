import matplotlib.pyplot as plt

def generate_lps(pattern):
    length = len(pattern)
    lps = [0] * length
    prefix_length = 0
    index = 1

    while index < length:
        if pattern[index] == pattern[prefix_length]:
            prefix_length += 1
            lps[index] = prefix_length
            index += 1
        else:
            if prefix_length != 0:
                prefix_length = lps[prefix_length - 1]
            else:
                lps[index] = 0
                index += 1
    return lps

def knuth_morris_pratt(text, pattern):
    text_len = len(text)
    pattern_len = len(pattern)
    lps = generate_lps(pattern)
    matches = []
    text_index = 0
    pattern_index = 0

    while text_index < text_len:
        if pattern[pattern_index] == text[text_index]:
            text_index += 1
            pattern_index += 1

        if pattern_index == pattern_len:
            matches.append(text_index - pattern_index)
            pattern_index = lps[pattern_index - 1]
        elif text_index < text_len and pattern[pattern_index] != text[text_index]:
            if pattern_index != 0:
                pattern_index = lps[pattern_index - 1]
            else:
                text_index += 1
    return matches, lps

def display_lps_graph(lps, pattern):
    plt.figure(figsize=(8, 4))
    plt.plot(range(len(lps)), lps, marker='o', color='g', label="LPS Array")
    plt.title(f"Pattern's LPS Array for: {pattern}")
    plt.xlabel("Pattern Index")
    plt.ylabel("LPS Value")
    plt.xticks(range(len(lps)), list(pattern))
    plt.grid(True)
    plt.legend()
    plt.show()

def display_match_graph(text, pattern, matches):
    plt.figure(figsize=(10, 2))
    annotated_text = [''] * len(text)
    for match_start in matches:
        for i in range(len(pattern)):
            annotated_text[match_start + i] = pattern[i]

    plt.plot(range(len(text)), [ord(c) for c in text], marker='x', linestyle='', label="Text")
    plt.plot(range(len(text)), [ord(c) if c != '' else None for c in annotated_text], marker='o', linestyle='', color='r', label="Matched Pattern")
    plt.title(f"Matching Process: Text: {text}")
    plt.xlabel("Text Index")
    plt.ylabel("Character ASCII Value")
    plt.grid(True)
    plt.legend()
    plt.show()


text_example = "ABABDABACDABABCABAB"
pattern_example = "ABABCABAB"
matches_found, lps_array = knuth_morris_pratt(text_example, pattern_example)

print(f"Pattern found at indices: {matches_found}")
display_lps_graph(lps_array, pattern_example)
display_match_graph(text_example, pattern_example, matches_found)
